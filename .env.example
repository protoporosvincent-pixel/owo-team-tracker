# Your Discord user token (selfbot)
DISCORD_TOKEN=your_token_here

# Your Discord User ID
YOUR_USER_ID=your_user_id_here

# OwO Bot User ID (default: 408785106942164992)
OWO_BOT_ID=408785106942164992

# NeonUtil Bot User ID
NEONUTIL_BOT_ID=neonutil_bot_id_here

# Channel ID where you want to run commands
CHANNEL_ID=your_channel_id_here
